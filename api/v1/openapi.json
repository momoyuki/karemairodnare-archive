{
  "components": {
    "schemas": {
      "Meta": {
        "properties": {
          "count": {
            "type": "integer"
          },
          "notice": {
            "description": "ข้อความกำกับที่ควรแสดงคู่กับข้อมูลเสมอ",
            "type": "string"
          },
          "site": {
            "format": "uri",
            "type": "string"
          },
          "snapshot": {
            "example": "2026-09-05",
            "format": "date",
            "type": "string"
          },
          "version": {
            "example": 1,
            "type": "integer"
          }
        },
        "required": [
          "version",
          "snapshot",
          "notice"
        ],
        "type": "object"
      },
      "Record": {
        "properties": {
          "agency": {
            "type": "string"
          },
          "district": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "maskedId": {
            "description": "ตามรูปแบบที่ปรากฏในเอกสาร ไม่ใช่ตัวระบุบุคคลที่ยืนยันได้เพียงลำพัง",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "province": {
            "type": "string"
          },
          "scoreChange": {
            "type": "integer"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "minItems": 1,
            "type": "array"
          },
          "url": {
            "description": "หน้าที่แสดงบริบทครบของรายการนี้",
            "format": "uri",
            "type": "string"
          },
          "verificationSource": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "province",
          "sources",
          "url"
        ],
        "type": "object"
      },
      "RecordCollection": {
        "properties": {
          "_meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "records": {
            "items": {
              "$ref": "#/components/schemas/Record"
            },
            "type": "array"
          }
        },
        "required": [
          "_meta",
          "records"
        ],
        "type": "object"
      },
      "Source": {
        "description": "ที่มาของแถวนี้ในเอกสารต้นฉบับ มีครบทุกแถวเสมอ",
        "properties": {
          "file": {
            "example": "66_ภูเก็ต.pdf",
            "type": "string"
          },
          "page": {
            "example": 3,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "file",
          "page"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "API แบบ static ทุก endpoint เป็นไฟล์ JSON ที่เสิร์ฟจาก CDN ไม่มี rate limit ไม่ต้องใช้ API key และเปิด CORS ให้ทุก origin\n\nเอกสารต้นทางมาจากแหล่งเผยแพร่สาธารณะ ยังไม่ได้รับการยืนยันจากหน่วยงานใด และไม่ได้เป็นการระบุสถานะทางคดี ความผิด หรือคำพิพากษาของบุคคล ชื่อที่คล้ายกันอาจเป็นคนละบุคคล ควรตรวจสอบกับเอกสารต้นฉบับตามเลขหน้าที่ระบุทุกครั้ง",
    "license": {
      "name": "ดูเงื่อนไขการนำไปใช้",
      "url": "https://260816-karemairodnare.vercel.app/api"
    },
    "title": "ชุดข้อมูลการแก้ไขคะแนน ปี 2568",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/agencies.json": {
      "get": {
        "responses": {
          "200": {
            "description": "สำเร็จ"
          }
        },
        "summary": "รายชื่อหน่วยงาน 1945 รายการ"
      }
    },
    "/agencies/{slug}.json": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "สำเร็จ"
          },
          "404": {
            "description": "ไม่พบ slug นี้"
          }
        },
        "summary": "รายการในหน่วยงานที่ระบุ"
      }
    },
    "/districts.json": {
      "get": {
        "responses": {
          "200": {
            "description": "สำเร็จ"
          }
        },
        "summary": "รายชื่ออำเภอ 657 รายการ"
      }
    },
    "/districts/{slug}.json": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "สำเร็จ"
          },
          "404": {
            "description": "ไม่พบ slug นี้"
          }
        },
        "summary": "รายการในอำเภอที่ระบุ"
      }
    },
    "/index.json": {
      "get": {
        "description": "จุดเริ่มต้นสำหรับสำรวจ API ให้ URL เต็มของทุก endpoint",
        "responses": {
          "200": {
            "description": "สำเร็จ"
          }
        },
        "summary": "รายการ endpoint ทั้งหมด"
      }
    },
    "/meta.json": {
      "get": {
        "responses": {
          "200": {
            "description": "สำเร็จ"
          }
        },
        "summary": "ข้อมูลกำกับชุดข้อมูล"
      }
    },
    "/provinces.json": {
      "get": {
        "responses": {
          "200": {
            "description": "สำเร็จ"
          }
        },
        "summary": "รายชื่อจังหวัด 77 รายการ"
      }
    },
    "/provinces/{slug}.json": {
      "get": {
        "parameters": [
          {
            "description": "slug ภาษาไทย ดูค่าที่ใช้ได้จาก /provinces.json",
            "example": "ภูเก็ต",
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordCollection"
                }
              }
            },
            "description": "สำเร็จ"
          },
          "404": {
            "description": "ไม่พบ slug นี้"
          }
        },
        "summary": "รายการในจังหวัดที่ระบุ"
      }
    },
    "/records.json": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordCollection"
                }
              }
            },
            "description": "สำเร็จ"
          }
        },
        "summary": "รายการทั้งหมด 3963 รายการ"
      }
    }
  },
  "servers": [
    {
      "description": "Production",
      "url": "https://260816-karemairodnare.vercel.app/api/v1"
    }
  ]
}
